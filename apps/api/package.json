{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "dev": "node --env-file=.env.example --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma": "prisma",
    "storage:check": "node dist/commands/storage-check.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@purchasing-plus/shared": "workspace:*",
    "busboy": "^1.6.0",
    "compression": "^1.8.2",
    "exceljs": "^4.4.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.7.5",
    "file-type": "^22.3.0",
    "heic-convert": "^2.1.0",
    "helmet": "^8.3.0",
    "prisma": "7.10.1",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/heic-convert": "^2.1.1",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0"
  }
}
