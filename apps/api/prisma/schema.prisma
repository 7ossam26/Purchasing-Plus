generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

enum RequestStatus {
  DRAFT
  AWAITING_MANAGER
  RETURNED
  AT_PURCHASING
  PAUSED
  FULFILMENT
  COMPLETED
  REJECTED
  CANCELLED
}

enum RequestStage {
  DRAFT
  AWAITING_MANAGER
  RETURNED
  AT_PURCHASING
  PAUSED
  AWAITING_APPROVAL
  AWAITING_RECEIPT
  REMAINING
  COMPLETED
  REJECTED
  CANCELLED
}

enum RequestUrgency {
  NORMAL
  URGENT
  VERY_URGENT
}

enum RequestItemState {
  OPEN
  UNAVAILABLE
  AWAITING_APPROVAL
  AWAITING_RECEIPT
  REMAINING
  RECEIVED
  RESOLVED_EXTERNALLY
  REJECTED
  CANCELLED
  REMOVED
}

model Request {
  id             Int                @id @default(autoincrement())
  number         String?            @unique
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  submittedAt    DateTime?
  version        Int
  status         RequestStatus
  displayedStage RequestStage
  stageStartedAt DateTime
  siteId         Int
  site           Site               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  categoryId     Int
  category       CatalogNode        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdById    Int
  creator        User               @relation("RequestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  urgency        RequestUrgency
  urgencyLocked  Boolean
  isModified     Boolean
  unitOrClient   String?
  note           String?
  deliveryFee    Decimal?           @db.Decimal(14, 2)
  pausedById     Int?
  pauser         User?              @relation("RequestPauser", fields: [pausedById], references: [id], onDelete: Restrict)
  pausedAt       DateTime?
  pauseReason    String?
  approvedById   Int?
  approver       User?              @relation("RequestApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  copiedFromId   Int?
  copiedFrom     Request?           @relation("RequestCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies         Request[]          @relation("RequestCopies")
  rounds         PricingRound[]
  batches        RfqBatch[]
  supplyOrders   SupplyOrder[]
  receipts       Receipt[]
  prices         CatalogItemPrice[]
  items          RequestItem[]
  events         RequestEvent[]
  notifications  Notification[]

  @@index([siteId, status])
  @@index([categoryId])
  @@index([createdById, categoryId])
  @@index([urgency(sort: Desc), stageStartedAt, id])
  @@index([siteId, urgency(sort: Desc), stageStartedAt, id])
  @@index([copiedFromId])
}

model RequestItem {
  id                Int                @id @default(autoincrement())
  requestId         Int
  request           Request            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  lineNo            Int
  catalogItemId     Int?
  catalogItem       CatalogItem?       @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  nodeId            Int
  node              CatalogNode        @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  snapshot          Json
  specs             String
  quantity          Decimal            @db.Decimal(14, 2)
  unitId            Int
  unit              Unit               @relation(fields: [unitId], references: [id], onDelete: Restrict)
  otherName         String?
  state             RequestItemState
  receivedQty       Decimal            @db.Decimal(14, 2)
  supplierId        Int?
  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lineTotal         Decimal?           @db.Decimal(14, 2)
  pricedQuantity    Decimal?           @db.Decimal(14, 2)
  unavailableNote   String?
  needsRepricing    Boolean
  modifiedAfterSend Boolean
  pickedAt          DateTime
  supplyLines       SupplyOrderItem[]
  receiptLines      ReceiptLine[]
  prices            CatalogItemPrice[]
  rfqLines          RfqBatchItem[]
  roundLines        PricingRoundItem[]

  @@unique([requestId, lineNo])
  @@index([catalogItemId, pickedAt])
  @@index([nodeId])
}

// SUBMITTED rounds go straight to receipt. PENDING, APPROVED and REJECTED are history from the
// removed pricing approval step; PENDING rounds are released by the one-time workflow migration.
enum PricingRoundStatus {
  PENDING
  APPROVED
  REJECTED
  SUBMITTED
}

model RfqBatch {
  id          Int                @id @default(autoincrement())
  requestId   Int
  request     Request            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  createdById Int
  creator     User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  message     String
  items       RfqBatchItem[]
  suppliers   RfqBatchSupplier[]

  @@index([requestId, id])
}

model RfqBatchItem {
  batchId Int
  batch   RfqBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  itemId  Int
  item    RequestItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([batchId, itemId])
  @@index([itemId])
}

model RfqBatchSupplier {
  batchId    Int
  batch      RfqBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  supplierId Int
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  message    String
  sentAt     DateTime?
  sentById   Int?
  sender     User?     @relation(fields: [sentById], references: [id], onDelete: Restrict)

  @@id([batchId, supplierId])
  @@index([supplierId])
}

model PricingRound {
  id            Int                @id @default(autoincrement())
  requestId     Int
  request       Request            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  number        Int
  status        PricingRoundStatus
  submittedAt   DateTime
  submittedById Int
  submitter     User               @relation("PricingSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  decidedAt     DateTime?
  decidedById   Int?
  decider       User?              @relation("PricingDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  deliveryFee   Decimal?           @db.Decimal(14, 2)
  items         PricingRoundItem[]

  @@unique([requestId, number])
}

model PricingRoundItem {
  previousPriceId Int?
  previousPrice   CatalogItemPrice? @relation(fields: [previousPriceId], references: [id], onDelete: Restrict)
  roundId         Int
  round           PricingRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  itemId          Int
  item            RequestItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lineNo          Int
  catalogItemId   Int?
  supplierId      Int
  supplier        Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lineTotal       Decimal           @db.Decimal(14, 2)
  quantity        Decimal           @db.Decimal(14, 2)

  @@id([roundId, itemId])
  @@index([itemId])
  @@index([supplierId])
}

model SupplyOrder {
  id         Int               @id @default(autoincrement())
  requestId  Int
  request    Request           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  number     Int
  supplierId Int
  supplier   Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  message    String
  createdAt  DateTime
  sentAt     DateTime?
  sentById   Int?
  sender     User?             @relation(fields: [sentById], references: [id], onDelete: Restrict)
  items      SupplyOrderItem[]

  @@unique([requestId, number])
  @@index([requestId, sentAt])
}

model SupplyOrderItem {
  orderId       Int
  order         SupplyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId        Int
  item          RequestItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lineNo        Int
  catalogItemId Int?
  quantity      Decimal     @db.Decimal(14, 2)
  lineTotal     Decimal     @db.Decimal(14, 2)

  @@id([orderId, itemId])
}

model Receipt {
  id           Int           @id @default(autoincrement())
  requestId    Int
  request      Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  recordedAt   DateTime
  recordedById Int
  recorder     User          @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  note         String?
  lines        ReceiptLine[]

  @@index([requestId, id])
}

model ReceiptLine {
  receiptId Int
  receipt   Receipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemId    Int
  item      RequestItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity  Decimal     @db.Decimal(14, 2)
  note      String?

  @@id([receiptId, itemId])
}

model RequestNumberSequence {
  year      Int @id
  lastValue Int
}

model RequestEvent {
  id            Int            @id @default(autoincrement())
  requestId     Int
  request       Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type          String
  actorId       Int?
  actor         User?          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorName     String?
  actorRoleName String?
  at            DateTime
  itemIds       Int[]
  payload       Json
  stageAfter    RequestStage
  notifications Notification[]

  @@index([requestId, id])
}

model Notification {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId Int
  request   Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  eventId   Int
  event     RequestEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  readAt    DateTime?

  @@unique([eventId, userId])
  @@index([userId, readAt, id])
  @@index([requestId])
  @@index([createdAt])
}

enum SiteScope {
  ASSIGNED
  ALL
}

model User {
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  id               Int                @id @default(autoincrement())
  name             String
  username         String             @unique
  passwordHash     String
  isSuperadmin     Boolean            @default(false)
  isActive         Boolean            @default(true)
  failedAttempts   Int                @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  roleId           Int?
  role             Role?              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sites            UserSite[]
  sessions         Session[]
  audits           AuditLog[]
  requests         Request[]          @relation("RequestCreator")
  approved         Request[]          @relation("RequestApprover")
  paused           Request[]          @relation("RequestPauser")
  requestEvents    RequestEvent[]
  notifications    Notification[]
  rfqBatches       RfqBatch[]
  ordersSent       SupplyOrder[]
  receipts         Receipt[]
  rfqSent          RfqBatchSupplier[]
  pricingSubmitted PricingRound[]     @relation("PricingSubmitter")
  pricingDecided   PricingRound[]     @relation("PricingDecider")

  @@index([roleId])
  @@index([isActive, id])
}

model Role {
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String           @default("")
  siteScope   SiteScope
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  key       String

  @@id([roleId, key])
}

model UserSite {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  siteId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@id([userId, siteId])
  @@index([siteId])
}

model Session {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Site {
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  id        Int        @id @default(autoincrement())
  name      String     @unique
  address   String     @default("")
  isActive  Boolean    @default(true)
  users     UserSite[]
  requests  Request[]
}

model Settings {
  id               Int       @id
  rfqIntro         String
  supplyOrderIntro String
  agingDays        Int       @default(3)
  catalogSeededAt  DateTime?
}

model CatalogNode {
  id           Int                @id @default(autoincrement())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  name         String
  parentId     Int?
  parent       CatalogNode?       @relation("CatalogTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     CatalogNode[]      @relation("CatalogTree")
  codePrefix   String?            @unique
  iconKey      String?
  sortOrder    Int
  isActive     Boolean            @default(true)
  path         String
  depth        Int
  attributes   NodeAttribute[]
  items        CatalogItem[]
  sequence     CodeSequence?
  suppliers    SupplierCategory[]
  requests     Request[]
  requestItems RequestItem[]

  @@index([parentId, sortOrder, id])
  @@index([path(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum CatalogAttributeType {
  TEXT
  NUMBER
  SELECT
}

model AttributeDefinition {
  id            Int                         @id @default(autoincrement())
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  name          String                      @unique
  type          CatalogAttributeType
  unitLabel     String?
  clientVisible Boolean                     @default(false)
  isActive      Boolean                     @default(true)
  options       AttributeOption[]
  nodes         NodeAttribute[]
  values        CatalogItemAttributeValue[]

  @@index([isActive, name])
}

model AttributeOption {
  id          Int                         @id @default(autoincrement())
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  attributeId Int
  attribute   AttributeDefinition         @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  label       String
  sortOrder   Int
  isActive    Boolean                     @default(true)
  values      CatalogItemAttributeValue[]

  @@unique([attributeId, label])
  @@unique([attributeId, id])
  @@index([attributeId, sortOrder, id])
}

model NodeAttribute {
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  nodeId      Int
  attributeId Int
  sortOrder   Int
  node        CatalogNode         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@id([nodeId, attributeId])
  @@index([nodeId, sortOrder])
  @@index([attributeId])
}

model Unit {
  id           Int           @id @default(autoincrement())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  name         String        @unique
  isActive     Boolean       @default(true)
  items        CatalogItem[]
  requestItems RequestItem[]

  @@index([isActive, name])
}

model CatalogItem {
  id              Int                         @id @default(autoincrement())
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  code            String                      @unique
  name            String
  description     String
  isActive        Boolean                     @default(true)
  searchText      String
  nodeId          Int
  node            CatalogNode                 @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  unitId          Int
  unit            Unit                        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  // Manually entered reference price. NULL means "not set", distinct from an explicit 0.00.
  unitPrice       Decimal?                    @db.Decimal(14, 2)
  attributeValues CatalogItemAttributeValue[]
  prices          CatalogItemPrice[]
  images          CatalogItemImage[]
  requestItems    RequestItem[]

  @@index([nodeId, name, id])
  @@index([unitId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model CatalogItemAttributeValue {
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  itemId      Int
  item        CatalogItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  attributeId Int
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  textValue   String?
  numberValue Decimal?            @db.Decimal(38, 12)
  optionId    Int?
  option      AttributeOption?    @relation(fields: [attributeId, optionId], references: [attributeId, id], onDelete: Restrict)

  @@id([itemId, attributeId])
  @@index([attributeId, optionId])
}

enum CatalogPriceSource {
  APPROVED
  REPRICED
  SUBMITTED
}

model CatalogItemPrice {
  id            Int                @id @default(autoincrement())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  itemId        Int
  item          CatalogItem        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  supplierId    Int
  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  requestId     Int
  requestItemId Int
  request       Request            @relation(fields: [requestId], references: [id], onDelete: Restrict)
  requestItem   RequestItem        @relation(fields: [requestItemId], references: [id], onDelete: Restrict)
  comparedLines PricingRoundItem[]
  unitPrice     Decimal            @db.Decimal(14, 2)
  source        CatalogPriceSource

  @@index([itemId, createdAt, id])
  @@index([supplierId])
  @@index([requestId])
  @@index([requestItemId])
}

model CodeSequence {
  categoryId Int         @id
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  category   CatalogNode @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  lastValue  Int
}

model Supplier {
  id             Int                @id @default(autoincrement())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  name           String
  contactPerson  String
  whatsappNumber String             @unique
  notes          String
  isActive       Boolean            @default(true)
  categories     SupplierCategory[]
  prices         CatalogItemPrice[]
  orders         SupplyOrder[]
  requestItems   RequestItem[]
  rfqBatches     RfqBatchSupplier[]
  roundLines     PricingRoundItem[]

  @@index([isActive, name, id])
  @@index([name, id])
}

model SupplierCategory {
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  supplierId Int
  supplier   Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId Int
  category   CatalogNode @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([supplierId, categoryId])
  @@index([categoryId])
}

model AuditLog {
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  id         Int      @id @default(autoincrement())
  action     String
  entity     String
  entityId   String?
  actorId    Int?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorLabel String?
  ip         String?
  oldValue   Json?
  newValue   Json?
  signature  String

  @@index([actorId])
  @@index([createdAt])
  @@index([action])
  @@index([entity])
}

model CatalogItemImage {
  id            Int         @id @default(autoincrement())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  itemId        Int
  item          CatalogItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  thumbKey      String      @unique
  displayKey    String      @unique
  width         Int
  height        Int
  cropX         Int?
  cropY         Int?
  cropSize      Int?
  sortOrder     Int
  isCover       Boolean     @default(false)
  pendingDelete Boolean     @default(false)

  @@index([itemId, sortOrder, id])
}
