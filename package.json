{
  "name": "purchasing-plus",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "postinstall": "pnpm --filter api prisma generate",
    "dev": "pnpm --filter @purchasing-plus/shared build && pnpm --parallel --filter api --filter web dev",
    "build": "pnpm --filter @purchasing-plus/shared build && pnpm --filter api build && pnpm --filter web build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "pretest": "pnpm --filter @purchasing-plus/shared build",
    "test": "vitest run",
    "pretest:coverage": "pnpm --filter @purchasing-plus/shared build",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "5.1.1"
  }
}
