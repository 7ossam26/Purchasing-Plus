{
  "name": "@purchasing-plus/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./permissions": {
      "types": "./src/permissions/index.ts",
      "default": "./dist/permissions/index.js"
    },
    "./lifecycle": {
      "types": "./src/lifecycle/index.ts",
      "default": "./dist/lifecycle/index.js"
    },
    "./events": {
      "types": "./src/events.ts",
      "default": "./dist/events.js"
    },
    "./i18n/ar": {
      "types": "./src/i18n/ar.ts",
      "default": "./dist/i18n/ar.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "zod": "^4.6.7"
  }
}
